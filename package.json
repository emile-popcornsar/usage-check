{
  "name": "usage-check",
  "productName": "Usage Check",
  "version": "0.1.1",
  "private": true,
  "description": "Claude 계정 사용량 확인 프로그램",
  "license": "MIT",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/semver": "^7.8.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "local.usagecheck.app",
    "productName": "Usage Check",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "UsageCheck-Setup-${version}-x64.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "emile-popcornsar",
        "repo": "usage-check",
        "releaseType": "release"
      }
    ]
  }
}
